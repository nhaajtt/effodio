{
  "name": "glint-site",
  "compatibility_date": "2026-11-01",
  "main": "./worker.js",
  // The site is files; only /api/ goes through the worker (the feedback form).
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "kv_namespaces": [{ "binding": "FEEDBACK", "id": "b8e66614cfa049cabf654488104b6bf4" }],
  "routes": [{ "pattern": "magpie.nhaajt.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
